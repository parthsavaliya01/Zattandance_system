# Docker Compose Project Configuration
COMPOSE_PROJECT_NAME=attendance_system

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DB=attendance_db

# Qdrant Vector DB Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_CENTROIDS=doctor_centroids
QDRANT_COLLECTION_EMBEDDINGS=doctor_embeddings

# Face Verification Thresholds
CENTROID_THRESHOLD=0.35
VERIFICATION_THRESHOLD=0.38
CONSECUTIVE_FRAMES=3
CONSECUTIVE_TIME_WINDOW=3.0
TOP_K=3


# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Camera RTSP Stream Configuration
CAMERA_IP_1=192.168.1.100
CAMERA_IP_2=192.168.1.101
CAMERA_USERNAME=admin
CAMERA_PASSWORD=camera_admin_password

# Darwinbox API Credentials (ERP System Integration)
DARWINBOX_API_URL=https://your-subdomain.darwinbox.in/AttendancePunchesApi
DARWINBOX_API_KEY=your_darwinbox_api_key_here
DARWINBOX_USERNAME=your_darwinbox_api_username
DARWINBOX_PASSWORD=your_darwinbox_api_password

# Web App CORS Origins (comma-separated origins)
CORS_ORIGINS=http://localhost:5103,http://127.0.0.1:5103

# Video Recording Configuration
RECORDING_ENABLED=True
RECORD_START_TIME=07:00
RECORD_STOP_TIME=21:00
RECORDINGS_PATH=./recordings

# Face Quality Gate and Recognition Window configuration
FACE_QUALITY_GATE_ENABLED=False
MIN_FACE_SIZE_PX=50
MAX_YAW_DEGREES=30.0
MIN_BLUR_SCORE=15.0
MAX_TRACKING_DURATION_SECONDS=0.0



